{
  "rules": {
    ".read": "false",
    ".write": "false",

    "parties": {
      ".read": "auth != null",
      ".indexOn": ["timestamp", "ownerId"],
      "$partyId": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('ownerId').val() == auth.uid)",
        "members": {
          "$memberId": {
            ".read": "auth != null",
            ".write": "auth != null && (data.parent().parent().child('ownerId').val() == auth.uid || $memberId == auth.uid)"
          }
        },
        "sync": {
          ".read": "auth != null",
          ".write": "auth != null && data.parent().child('ownerId').val() == auth.uid"
        },
        "authenticatedUsers": {
          "$uid": {
            ".read": "auth != null",
            ".write": "auth != null && (data.parent().parent().child('ownerId').val() == auth.uid || $uid == auth.uid)"
          }
        },
        "webrtc_signaling": {
          ".read": "auth != null",
          ".write": "auth != null",
          "$messageId": {
            ".validate": "newData.hasChildren(['type', 'payload', 'senderId']) && newData.child('senderId').val() == auth.uid",
            ".indexOn": ["timestamp"]
          }
        }
      }
    },

    "presence": {
      ".read": "auth != null",
      "$userId": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $userId",
        ".validate": "newData.hasChildren(['online', 'lastSeen'])"
      }
    },

    "users": {
      "$userId": {
        ".read": "auth != null && auth.uid == $userId",
        ".write": "auth != null && auth.uid == $userId"
      }
    }
  }
}
