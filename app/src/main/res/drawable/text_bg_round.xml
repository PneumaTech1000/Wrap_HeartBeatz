<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Inner Shadow -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#608B5CF6" /> <!-- 25% alpha of #8B5CF6 -->
            <corners android:bottomLeftRadius="16dp"
                android:topLeftRadius="16dp"
                android:topRightRadius="16dp"
                android:bottomRightRadius="16dp" />
        </shape>
    </item>

    <!-- Main button shape -->
    <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:color="?attr/colorPrimary" android:width="2dp"/>
            <corners android:bottomLeftRadius="16dp"
                android:topLeftRadius="16dp"
                android:topRightRadius="16dp"
                android:bottomRightRadius="16dp"/>

        </shape>
    </item>

</layer-list>
