        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>
    -->

    <!-- Corners only -->
    <style name="ShapeAppearance.ChatBubble.Incoming" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">16dp</item>
        <item name="cornerSizeTopRight">16dp</item>
        <item name="cornerSizeBottomRight">16dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
    </style>

    <style name="ShapeAppearance.ChatBubble.Outgoing" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">16dp</item>
        <item name="cornerSizeTopRight">16dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
        <item name="cornerSizeBottomLeft">16dp</item>
    </style>

    <!-- Card look: color + shape + elevation -->
    <style name="Widget.HeartBeatz.ChatBubble.Incoming" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">?attr/colorSurfaceVariant</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.ChatBubble.Incoming</item>
    </style>

    <style name="Widget.HeartBeatz.ChatBubble.Outgoing" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">?attr/colorPrimary</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.ChatBubble.Outgoing</item>
    </style>

</resources>