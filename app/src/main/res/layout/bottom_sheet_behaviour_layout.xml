<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageButton
        android:id="@+id/close_bottom_sheet"
        android:layout_width="40dp"
        android:layout_height="32dp"
        android:background="?android:selectableItemBackground"
        android:scaleType="centerCrop"
        android:src="@drawable/keyboard_arrow_up_24px"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/colorOnSurfaceVariant" />

    <com.realgear.readable_bottom_bar.ReadableBottomBar
        android:id="@+id/bottom_sheet_nav_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/pager_bottom_height"
        android:clickable="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/close_bottom_sheet"
        app:rbb_iconSize="20dp"
        app:rbb_indicatorAppearance="round"
        app:rbb_tabColor="@color/hb_primary"
        app:rbb_tabColorSelected="@color/hb_primary"
        app:rbb_indicatorColor="@color/hb_primary_container"
        app:rbb_indicatorHeight="4dp"
        app:rbb_indicatorMargin="20dp"
        app:rbb_indicatorStyle="normal"
        app:rbb_selectedIndex="0"
        app:rbb_selectedTabType="text"
        app:rbb_tabs="@menu/bottom_sheet_nav_bar_tab"
        app:rbb_textStyle="bold" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/bottom_sheet_view_pager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bottom_sheet_nav_bar" />


</androidx.constraintlayout.widget.ConstraintLayout>