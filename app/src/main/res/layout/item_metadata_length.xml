<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="4dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_metadata_item"
    android:clickable="true"
    android:focusable="true">

    <!-- Icon -->
    <FrameLayout
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_icon_circle">

        <ImageView
            android:id="@+id/metaIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerInside"
            android:src="@drawable/graphic_eq_24px"
            app:tint="?attr/colorPrimary" />
    </FrameLayout>

    <!-- Text -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txt_sample_rate"
            android:text="44.1 KHz/16-bit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurface"
            android:maxLines="1"
            android:ellipsize="middle" />

        <TextView
            android:id="@+id/metaLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_sample_rate"
            android:textSize="11sp"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>


    <!-- Text -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txt_length"
            android:text="04:03"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurface"
            android:maxLines="1"
            android:ellipsize="middle" />

        <TextView
            android:id="@+id/sizeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_length"
            android:textSize="11sp"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

</LinearLayout>
