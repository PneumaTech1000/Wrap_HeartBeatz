<?xml version="1.0" encoding="utf-8"?>
<!--
  Sheet content. BottomSheet peek shows the BOTTOM of this view.
  paddingBottom = nav height so mini (gravity=bottom) sits above the nav sibling.
  peekHeight must equal mini height + nav height.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/media_player_root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingBottom="@dimen/navigation_bar_height"
    android:clipToPadding="false"
    android:clickable="true"
    android:focusable="true">

    <!-- Full player (fades in with expand) -->
    <include
        layout="@layout/media_player_full_sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Mini: bottom of padded area = bottom of visible peek above nav -->
    <FrameLayout
        android:id="@+id/mini_player_slot"
        android:layout_width="match_parent"
        android:layout_height="@dimen/media_player_bar_height"
        android:layout_gravity="bottom"
        android:elevation="20dp"
        android:translationZ="20dp">

        <include
            layout="@layout/media_player_bar_bottom_sheet"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

</FrameLayout>
