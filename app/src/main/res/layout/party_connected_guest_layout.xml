<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/partyGuestsRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="24dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/headerCard"
            style="@style/Widget.Material3.CardView.Elevated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="28dp"
            app:cardElevation="2dp"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeWidth="0dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp">

                <TextView
                    android:id="@+id/partyTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/connected_guests"
                    android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@+id/btnCloseParty"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/partyBadgeChip"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/party_active"
                    app:chipCornerRadius="12dp"
                    app:chipIcon="@drawable/wifi_24px"
                    app:chipIconSize="16dp"
                    app:chipIconTint="?attr/colorPrimary"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/partyTitle"
                    app:strokeWidth="0dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/partyStatus"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/label_host"
                    android:textColor="?attr/colorOnPrimary"
                    app:chipBackgroundColor="?attr/colorPrimary"
                    app:chipCornerRadius="12dp"
                    app:chipIcon="@drawable/celebration_24px"
                    app:chipIconSize="16dp"
                    app:chipIconTint="?attr/colorOnPrimary"
                    app:layout_constraintStart_toEndOf="@+id/partyBadgeChip"
                    app:layout_constraintTop_toTopOf="@id/partyBadgeChip"
                    app:strokeWidth="0dp" />

                <TextView
                    android:id="@+id/deviceCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12 Devices"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    app:layout_constraintBottom_toBottomOf="@id/partyBadgeChip"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/partyBadgeChip" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCloseParty"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    app:icon="@drawable/close_24px"
                    app:iconTint="?attr/colorError"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/tabCapsule"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
            app:cardCornerRadius="32dp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/headerCard"
            app:strokeWidth="0dp">

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/partyTabs"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginHorizontal="4dp"
                android:background="@android:color/transparent"
                app:tabBackground="@android:color/transparent"
                app:tabIndicator="@drawable/tab_indicator_background_color"
                app:tabIndicatorAnimationMode="elastic"
                app:tabIndicatorColor="?attr/colorPrimary"
                app:tabIndicatorGravity="center"
                app:tabIndicatorHeight="40dp"
                app:tabMaxWidth="140dp"
                app:tabMinWidth="100dp"
                app:tabMode="fixed"
                app:tabRippleColor="@android:color/transparent"
                app:tabSelectedTextColor="?attr/colorOnPrimary"
                app:tabTextAppearance="@style/TextAppearance.Material3.LabelLarge"
                app:tabTextColor="?attr/colorOnSurfaceVariant">

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Guests" />

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="QR Code" />
            </com.google.android.material.tabs.TabLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- CONTENT AREA -->
        <FrameLayout
            android:id="@+id/partyContentFrame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="340dp"
            app:layout_constraintTop_toBottomOf="@id/tabCapsule">

            <!-- GUEST LIST VIEW -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/guestsRecycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:paddingHorizontal="16dp"
                android:paddingTop="8dp"
                tools:listitem="@layout/item_party_guest" />

            <!-- NO GUESTS PLACEHOLDER -->
            <LinearLayout
                android:id="@+id/tvNoGuests"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="20dp"
                        android:src="@drawable/person_add_24px"
                        app:tint="?attr/colorPrimary" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/waiting_for_guests"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:alpha="0.7"
                    android:gravity="center"
                    android:text="@string/waiting_for_guests_desc"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall" />
            </LinearLayout>

            <!-- QR CODE VIEW (Hidden by default) -->
            <LinearLayout
                android:id="@+id/qrContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="32dp"
                    app:cardElevation="2dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="1dp">

                    <ImageView
                        android:id="@+id/ivHostQrCode"
                        android:layout_width="260dp"
                        android:layout_height="260dp"
                        android:padding="24dp"
                        android:scaleType="fitCenter"
                        tools:src="@tools:sample/avatars" />

                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvPartyPin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.2"
                        android:text="PIN: ••••"
                        android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
                        android:textColor="?attr/colorPrimary"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btnTogglePartyPin"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Show or hide PIN"
                        android:src="@android:drawable/ic_menu_view"
                        app:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:alpha="0.7"
                    android:text="@string/scan_to_join"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

            </LinearLayout>
        </FrameLayout>

        <!-- ACTION BUTTONS -->
        <LinearLayout
            android:id="@+id/actionsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="24dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/partyContentFrame">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnInviteContainer"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:text="@string/label_invite"
                app:cornerRadius="20dp"
                app:icon="@drawable/person_add_24px" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShareParty"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginStart="12dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:padding="0dp"
                app:cornerRadius="20dp"
                app:icon="@drawable/share_24px"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvPartyLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/link_copied"
            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
            android:textColor="?attr/colorPrimary"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/actionsContainer" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
